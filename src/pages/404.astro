---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site.ts';
---

<Base
  title="Nothing on the bench here"
  description="That page doesn't exist — it may never have, or its slug may have moved."
  path="/404"
>
  <h1>Nothing on the bench here</h1>
  <p class="standfirst">
    That page doesn&rsquo;t exist. Slugs here are permanent, so this is more likely
    a typo than something that moved.
  </p>
  <hr class="rule" />
  <p>
    Try <a href="/">the index</a> — it lists everything on the bench, most
    recently honed first. Agents can start at <a href="/llms.txt">llms.txt</a>.
  </p>
  <p class="caption">{SITE.tagline}</p>
</Base>
