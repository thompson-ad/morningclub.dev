---
/**
 * The stage mark: a fill-state dot beside a lowercase word.
 *
 * Encoded by fill rather than hue (○ ◐ ●) so it survives a monochrome palette
 * and any form of colour blindness by construction. Drawn in CSS rather than
 * with unicode glyphs, whose rendering varies wildly across platforms (§6.2).
 */
import type { Stage } from '../lib/site.ts';

interface Props {
  stage: Stage;
}

const { stage } = Astro.props;
---

<span class="stage" data-stage={stage}>{stage}</span>
